{
  "name": "agropecas-api",
  "version": "0.1.0",
  "private": true,
  "description": "API da plataforma AgroPeças MT — conexão entre produtores, lojas de peças e prestadores de serviços.",
  "main": "app.js",
  "scripts": {
    "start": "node app.js",
    "dev": "node --watch app.js",
    "worker": "node worker.js",
    "worker:dev": "node --watch worker.js",
    "migrate": "sequelize-cli db:migrate",
    "migrate:undo": "sequelize-cli db:migrate:undo",
    "seed": "sequelize-cli db:seed:all",
    "models:check": "node scripts/check-models.js",
    "migrate:status": "sequelize-cli db:migrate:status",
    "rbac:sync": "node scripts/rbac-sync.js",
    "rbac:check": "node scripts/rbac-check.js",
    "validacao:check": "node scripts/validacao-check.js",
    "setup": "npm run migrate && npm run seed",
    "test:auth": "node scripts/testar.js auth.fluxo",
    "test:rbac": "node scripts/testar.js auth.rbac",
    "test:seguranca": "node scripts/testar.js auth.seguranca",
    "test": "node scripts/testar.js",
    "test:configuracao": "node scripts/testar.js configuracao",
    "test:usuario": "node scripts/testar.js usuario",
    "test:midia": "node scripts/testar.js midia",
    "test:catalogo": "node scripts/testar.js catalogo",
    "test:perfil": "node scripts/testar.js perfil",
    "test:localizacao": "node scripts/testar.js localizacao",
    "test:anuncio": "node scripts/testar.js anuncio",
    "test:favorito": "node scripts/testar.js favorito",
    "test:contato": "node scripts/testar.js contato",
    "test:conversa": "node scripts/testar.js conversa",
    "test:notificacao": "node scripts/testar.js notificacao",
    "test:lgpd": "node scripts/testar.js lgpd",
    "test:auditoria": "node scripts/testar.js auditoria",
    "test:denuncia": "node scripts/testar.js denuncia",
    "test:moderacao": "node scripts/testar.js moderacao",
    "test:plano": "node scripts/testar.js plano",
    "test:relatorio": "node scripts/testar.js relatorio",
    "test:busca": "node scripts/testar.js busca",
    "test:sistema": "node scripts/testar.js sistema.seguranca",
    "test:admin-catalogo": "node scripts/testar.js admin.catalogo",
    "test:admin-comunidade": "node scripts/testar.js admin.comunidade",
    "test:admin-conformidade": "node scripts/testar.js admin.conformidade",
    "test:admin-conteudo": "node scripts/testar.js admin.conteudo",
    "test:admin-painel": "node scripts/testar.js admin.painel",
    "test:admin-plataforma": "node scripts/testar.js admin.plataforma",
    "test:admin-usuarios": "node scripts/testar.js admin.usuarios",
    "test:admin": "node scripts/testar.js admin.catalogo admin.comunidade admin.conformidade admin.conteudo admin.painel admin.plataforma admin.usuarios admin.seguranca",
    "test:admin-seguranca": "node scripts/testar.js admin.seguranca"
  },
  "dependencies": {
    "@socket.io/redis-adapter": "^8.3.0",
    "bcryptjs": "^3.0.3",
    "bullmq": "^6.0.11",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "helmet": "^8.3.0",
    "ioredis": "^6.0.0",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.2.0",
    "pg": "^8.12.0",
    "pg-hstore": "^2.3.4",
    "resend": "^6.20.0",
    "sequelize": "^6.37.3",
    "sequelize-cli": "^6.6.2",
    "sharp": "^0.35.3",
    "socket.io": "^4.8.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "socket.io-client": "^4.8.3"
  },
  "engines": {
    "node": ">=20"
  }
}
