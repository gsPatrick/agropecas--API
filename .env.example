# ─── APLICAÇÃO ────────────────────────────────────────────────
NODE_ENV=development
APP_PORT=3333
APP_API_PREFIX=/api
APP_URL=http://localhost:3333
APP_WEB_URL=http://localhost:3000

# ─── BANCO DE DADOS ───────────────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_NAME=agropecas
DB_USER=postgres
DB_PASSWORD=
DB_SSL=false
DB_LOGGING=false
DB_POOL_MAX=10
DB_POOL_MIN=0

# ─── SEGURANÇA ────────────────────────────────────────────────
# usado para gerar hash de IP nos registros de auditoria (LGPD: pseudonimização)
SECURITY_IP_SALT=troque-por-uma-string-longa-e-aleatoria
JWT_SECRET=troque-por-uma-string-longa-e-aleatoria
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d
BCRYPT_ROUNDS=12
# origens autorizadas do front (separadas por vírgula)
CORS_ORIGENS=http://localhost:3000

# ─── AUTENTICAÇÃO ─────────────────────────────────────────────
AUTH_OTP_DIGITOS=6
# validade do código de recuperação de senha, em minutos
AUTH_OTP_MINUTOS=15
# validade do código de confirmação de e-mail, em horas
AUTH_VERIFICACAO_EMAIL_HORAS=24
# tentativas de senha erradas antes de bloquear a CONTA (não o IP)
AUTH_MAX_TENTATIVAS=5
AUTH_JANELA_TENTATIVAS_MINUTOS=15
AUTH_BLOQUEIO_MINUTOS=30
# sessões simultâneas por usuário; ao estourar, a mais antiga é revogada
AUTH_MAX_SESSOES=10
# true exige e-mail confirmado para entrar
AUTH_EXIGIR_EMAIL_VERIFICADO=false

# ─── REDIS · CACHE · FILAS ────────────────────────────────────
# Opcional. SEM ele o sistema funciona: cache vai para memória e job roda no
# próprio processo. Em PRODUÇÃO é fortemente recomendado — sem Redis não há
# retentativa de job, agendamento nem limite de requisição compartilhado
# entre instâncias.
REDIS_URL=redis://127.0.0.1:6379
REDIS_PREFIXO=agropecas

CACHE_ATIVO=true
# segundos; curto de propósito — dado velho em cache é pior que consulta a mais
CACHE_TTL_PADRAO=60

FILAS_TENTATIVAS=3
FILAS_ESPERA_INICIAL_MS=5000
FILAS_CONCORRENCIA=5
FILAS_MANTER_CONCLUIDOS=500
FILAS_MANTER_FALHADOS=5000

# ─── INTEGRAÇÕES ──────────────────────────────────────────────
VIACEP_BASE_URL=https://viacep.com.br/ws
GEOCODE_BASE_URL=https://api.bigdatacloud.net/data/reverse-geocode-client

# ─── ARMAZENAMENTO DE IMAGENS ─────────────────────────────────
STORAGE_DRIVER=local
STORAGE_LOCAL_PATH=./uploads
STORAGE_PUBLIC_URL=http://localhost:3333/uploads

# ─── LGPD ─────────────────────────────────────────────────────
# dias que dados de conta excluída ficam anonimizados antes do descarte físico
LGPD_RETENCAO_DIAS=180
LGPD_ENCARREGADO_EMAIL=contato@agropecasmt.com.br
